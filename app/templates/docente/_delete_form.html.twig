<form id="docente-delete-form" method="post" action="{{ path('app_docente_delete', {'id': docente.id}) }}" onsubmit="return confirm('Esta seguro que quiere eliminar este docente?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ docente.id) }}">
    <button class="">Eliminar</button>
</form>
