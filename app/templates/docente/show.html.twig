{% extends 'base.html.twig' %}

{% block title %}Docente{% endblock %}

{% block body %}
<div class="p-3">
    <div class="bg-white rounded mt-2">
        <table class="table">
            <tbody>
                <tr>
                    <th>Nombre</th>
                    <td>{{ docente.nombre }}</td>
                </tr>
                <tr>
                    <th>Apellido</th>
                    <td>{{ docente.apellido}}</td>
                </tr>
                <tr>
                    <th>DNI</th>
                    <td>{{ docente.dni }}</td>
                </tr>
                <tr>
                    <th>Correo</th>
                    <td>{{ docente.email }}</td>
                </tr>
                <tr>
                    <th>Telefono</th>
                    <td>{{ docente.telefono }}</td>
                </tr>
            </tbody>
        </table>

        <div class="row p-2">
            <div class="col-auto">
                <a class="btn btn-secondary" href="{{ path('app_docente_index') }}">Volver</a>
            </div>
            <div class="col-auto">
                <a class="btn btn-secondary" href="{{ path('app_docente_edit', {'id': docente.id}) }}">Editar</a>
            </div>
            <div class="col-auto">
                {{ include('docente/_delete_form.html.twig') }}
            </div>
        </div>
    </div>
</div>
{% endblock %}
