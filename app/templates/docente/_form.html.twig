<div class="container-fluid">
    <div class="row">
        <div class="col-4">
            <div class="bg-white rounded p-2 mt-2">
                {{ form_start(form) }}
                <div class="row mt-2 mb-2">
                    <div class="col-4">
                        Nombre
                    </div>
                    <div class="col-2">
                        {{ form_widget(form.nombre) }}
                    </div>
                </div>
                <div class="row mt-2 mb-2">
                    <div class="col-4">
                        Apellido
                    </div>
                    <div class="col">
                        {{ form_widget(form.apellido) }}
                    </div>
                </div>
                <div class="row mt-2 mb-2">
                    <div class="col-4">
                        DNI
                    </div>
                    <div class="col">
                        {{ form_widget(form.dni) }}
                    </div>
                </div>
                <div class="row mt-2 mb-2">
                    <div class="col-4">
                        Correo
                    </div>
                    <div class="col">
                        {{ form_widget(form.email) }}
                    </div>
                </div>
                <div class="row mt-2 mb-2">
                    <div class="col-4">
                        Telefono
                    </div>
                    <div class="col">
                        {{ form_widget(form.telefono) }}
                    </div>
                </div>
                <div class="row mt-2 mb-2">
                    <div class="col-4">
                    </div>
                    <div class="col">
                        <div class="row">
                            <div class="col">
                                <button class="btn btn-primary">{{ button_label|default('Save') }}</button>
                            </div>
                            <div class="col">

                            </div>
                        </div>
                    </div>
                </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
    
</div>