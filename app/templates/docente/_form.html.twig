{{ form_start(form) }}
<div class="row align-items-start">
    <div class="col-auto">
        <div class="me-2">
            <span class="fw-bold mb-2">Nombre</span>
            <br class="m-2">
            {{ form_widget(form.nombre, {'attr': {'class': 'form-control'}}) }}
        </div>
    </div>
    <div class="col-auto">
        <div class="me-2">
            <span class="fw-bold mb-2">Apellido</span>
            <br class="m-2">
            {{ form_widget(form.apellido, {'attr': {'class': 'form-control'}}) }}
        </div>
    </div>
    <div class="col-auto">
        <div class="me-2">
            <span class="fw-bold mb-2">DNI</span>
            <br class="m-2">
            {{ form_widget(form.dni, {'attr': {'class': 'form-control'}}) }}
        </div>
    </div>
    <div class="col-auto">
        <div class="me-2">
            <span class="fw-bold mb-2">Correo</span>
            <br class="m-2">
            {{ form_widget(form.email, {'attr': {'class': 'form-control'}}) }}
        </div>
    </div>
    <div class="col-auto">
        <div class="me-2">
            <span class="fw-bold mb-2">Teléfono</span>
            <br class="m-2">
            {{ form_widget(form.telefono, {'attr': {'class': 'form-control'}}) }}
        </div>
    </div>
    <div class="col-auto">
    <div class="col-auto">
    <div class="col-auto">
    <div class="col-auto">
        <div class="me-2">
            <button class="btn-verde">{{ button_label|default('Save') }}</button>
        </div>
    </div>
</div>
{{ form_end(form) }}
