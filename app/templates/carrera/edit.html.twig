{% extends 'base.html.twig' %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('/styles/carrera/edit.css')}}">
{% endblock %}

{% block title %}Editor de Carrera{% endblock %}

{% block body %}
    <div class="main-content-edit-carrera">
        <div class="cursos">
            <div class="cursos-obligatorios">
                <div class="header">
                    <h2>Cursos Obligatorios</h2>
                    <button class="agregar-button" id="agregar-button-obligatorios">+ Agregar</button>
                </div>
                <div class="body-cursos-obligatorios">
                    <table>
                        <thead>
                            <tr>
                                <th>Nombre</th>
                                <th>Nro. Ordenanza</th>
                                <th>Nro. Implementación</th>
                                <th>Acción</th> 
                            </tr>
                        </thead>
                        <tbody>
                            {% for cursoObligatorio in cursosObligatorios %}
                            <tr>        
                                <td>{{ cursoObligatorio.nombre }}</td>
                                <td>{{ cursoObligatorio.nroOrdenanza }}</td>
                                <td>{{ cursoObligatorio.nroImplementacion }}</td>
                                <td>...</td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                    <div class="agregar-cursos" id="agregar-curso-obligatorios">
                        {{ include('carrera/_agregar_curso.html.twig', { 'cursosRestantes': cursosRestantes }) }}
                    </div>
                </div>
            </div>
            <div class="cursos-electivos">
                <div class="header">
                    <h2>Cursos Electivos</h2>
                    <button class="agregar-button" id="agregar-button-electivos">+ Agregar</button>
                </div>
                <div class="body-cursos-electivos">
                    <table>
                        <thead>
                            <tr>
                                <th>Nombre</th>
                                <th>Nro. Ordenanza</th>
                                <th>Nro. Implementación</th>
                                <th>Acción</th> 
                            </tr>
                        </thead>
                        <tbody>
                            {% for cursoElectivo in cursosElectivos %}
                            <tr>        
                                <td>{{ cursoElectivo.nombre }}</td>
                                <td>{{ cursoElectivo.nroOrdenanza }}</td>
                                <td>{{ cursoElectivo.nroImplementacion }}</td>
                                <td>...</td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                    <div class="agregar-cursos" id="agregar-curso-electivos">
                        {{ include('carrera/_agregar_curso.html.twig', { 'cursosRestantes': cursosRestantes }) }}
                    </div>
                </div>
            </div>
        </div>
        <div class="editor-carrera">
            <h2>Carrera</h2>
            {{ include('carrera/_form.html.twig', {'button_label': 'Guardar'}) }}

            {{ include('carrera/_delete_form.html.twig') }}
        </div>
    </div>
    <script>
        document.querySelector('.cursos-obligatorios .agregar-button').addEventListener('click', function() {
            let contenedor = document.querySelector('.cursos-obligatorios');
            let lista = document.getElementById('agregar-curso-obligatorios');
            let button = document.getElementById('agregar-button-obligatorios');
            contenedor.classList.toggle('expandido');
            if(contenedor.classList.contains('expandido')){
                lista.classList.add('visible');
                button.textContent = 'Cancelar';
            } else {
                lista.classList.remove('visible');
                button.textContent = '+ Agregar';
            }
        });

        document.querySelector('.cursos-electivos .agregar-button').addEventListener('click', function() {
            let contenedor = document.querySelector('.cursos-electivos');
            let lista = document.getElementById('agregar-curso-electivos');
            let button = document.getElementById('agregar-button-electivos');
            contenedor.classList.toggle('expandido');
            if(contenedor.classList.contains('expandido')){
                lista.classList.add('visible');
                button.textContent = 'Cancelar';
            } else {
                lista.classList.remove('visible');
                button.textContent = '+ Agregar';
            }
        });
    </script>
{% endblock %}

