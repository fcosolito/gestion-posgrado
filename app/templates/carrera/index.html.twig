{% extends 'base.html.twig' %}

{% block title %}Carreras{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/carrera/index.css') }}">
{% endblock %}

{% block body %}
    <div class="buscador-carreras">
        <h2>Buscar</h2>
        {{ include('/carrera/_search_form.html.twig',{
                'searchForm':searchForm 
            })
        }}
    </div>
    <div class="main-content-carreras">
        <header class="main-content-carreras-header">
            <h2>Carreras</h2>
            <a href="{{ path('app_carrera_new') }}">+ Nueva</a>
        </header>
        <div class="main-content-carreras-body">
            <table class="table-carreras">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Nro. Ordenanza</th>
                        <th>Nro. Implementacion</th>
                        <th>Inscriptos</th>
                        <th>Acción</th>
                    </tr>
                </thead>
                <tbody>
                {% for carrera in carreras %}
                    <tr>
                        <td>{{ carrera.nombre }}</td>
                        <td>{{ carrera.nroOrdenanza }}</td>
                        <td>{{ carrera.nroImplementacion }}</td>
                        <td>{{ inscriptosPorCarrera[carrera.id] }}</td>
                        <td>
                            <div class="dropdown">
                                <button class="btn btn-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Acciones
                                </button>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" href="{{ path('app_carrera_show', {'id': carrera.id}) }}">Ver</a></li>
                                    <li><a class="dropdown-item" href="{{ path('app_carrera_edit', {'id': carrera.id}) }}">Editar</a></li>
                                </ul>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="7">no records found</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div> 
{% endblock %}
