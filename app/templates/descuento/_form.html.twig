{{ form_start(form) }}
<div class="row align-items-start">
    <div class="col-auto">
        <div class="me-2">
            <span class="fw-bold mb-2">Descripcion</span>
            <br class="m-2">
            {{ form_widget(form.descripcion, {'attr': {'class': 'form-control'}}) }}
        </div>
    </div>
    <div class="col-auto">
        <div class="me-2">
            <span class="fw-bold mb-2">Valor</span>
            <br class="m-2">
            {{ form_widget(form.valor, {'attr': {'class': 'form-control'}}) }}
        </div>
    </div>
    <div class="col-auto">
        <div class="me-2">
            <button class="btn-verde">{{ button_label|default('Save') }}</button>
        </div>
    </div>
</div>

{{ form_end(form) }}