{% extends 'base.html.twig' %}

{% block title %}Descuentos{% endblock %}

{% block body %}
<div class="p-3">
    <div class="cuadrado-reutilizable fill-remaining">
        <div class="row p-3">
            <div class="col">
                <h4>Descuentos</h4>
            </div>
            <div class="col-auto">
                <div class="row">
                    <div class="col">
                        <button
                            id="btn-nuevo"
                            class="btn-verde btn-primario"
                        >
                            Nuevo
                        </button>
                    </div>
                </div>
            </div>
        </div>
            <div class="h-100 overflow-scroll p-0">
                <table class="table table-bordered">
                    <thead class="sticky-top table-secondary">
                        <tr>
                            <th class="fw-regular">Valor</th>
                            <th class="fw-regular">Descripcion</th>
                            <th class="fw-regular">Acción</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for descuento in descuentos %}
                            <tr>
                                <td class="fw-light" style="width: 15%;">{{ descuento.valor}}</td>
                                <td class="fw-light text-wrap">{{ descuento.descripcion}}</td>
                                <td style="width: 15%;">
                                    {{ include('_dropdown_acciones.html.twig', {
                                        opciones: [
                                            { 
                                                label: 'Ver', 
                                                url: path('app_descuento_show', {'id': descuento.id}) 
                                            },
                                            { 
                                                label: 'Editar', 
                                                url: path('app_descuento_edit', {'id': descuento.id}) 
                                            }
                                        ]
                                    }) }}
                                </td>
                            </div>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="5"><i>No se registraron descuentos</i></td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

{% endblock %}

{% block javascripts %}
<script>
    document.addEventListener('DOMContentLoaded', () => {
        const btnNuevo = document.getElementById('btn-nuevo');

        btnNuevo.addEventListener('click', () => window.location.href = "{{ path('app_descuento_new') }}");
    })
</script>
{% endblock %}