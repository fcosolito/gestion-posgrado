{% extends 'base.html.twig' %}

{% block title %}Descuentos{% endblock %}

{% block body %}
<div class="p-3">
<div class="rounded bg-white vh-100 p-0">
    <div class="row p-3">
        <div class="col">
            <h3>Descuentos</h3>
        </div>
        <div class="col text-end">
            <a class="btn btn-primary" href="{{ path('app_descuento_new') }}">Nuevo</a>
        </div>
    </div>
    <div class="h-100 overflow-scroll p-0">
        <table class="table table-responsive table-striped table-bordered table-hover">
            <thead class="sticky-top table-secondary">
                <tr>
                    <th>Valor</th>
                    <th>Descripcion</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                {% for descuento in descuentos %}
                    <tr>
                        <td style="width: 15%;">{{ descuento.valor}}</td>
                        <td class="text-wrap">{{ descuento.descripcion}}</td>
                        <td style="width: 15%;">
                            <div class="dropdown">
                                <button class="btn btn-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Acciones
                                </button>
                                <ul class="dropdown-menu" >
                                    <li><a class="dropdown-item" href="{{ path('app_descuento_show', {'id': descuento.id}) }}">Ver</a></li>
                                    <li><a class="dropdown-item" href="{{ path('app_descuento_edit', {'id': descuento.id}) }}">Editar</a></li>
                                </ul>
                            </div>
                        </td>
                    </div>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="5"><i>No se registraron descuentos</i></td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
</div>

{% endblock %}
