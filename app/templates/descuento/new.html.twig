{% extends 'base.html.twig' %}

{% block title %}Descuentos{% endblock %}

{% block body %}
<div class="p-3">
    <div class="cuadrado-reutilizable p-3">
        <div class="row">
            <div class="col">
                <h4>Nuevo descuento</h4>
            </div>
            <div class="col-auto">
                <div class="row">
                    <div class="col">
                        <button
                            id="btn-volver"
                            class="btn-gris btn-alternativo"
                        >
                            Volver
                        </button>
                    </div>
                </div>
            </div>
        </div>
        {{ include('descuento/_form.html.twig', {'button_label': "Registrar"}) }}

        </div>
    </div>
</div>

{% endblock %}

{% block javascripts %}
<script>
    document.addEventListener('DOMContentLoaded', () => {
        const btnVolver = document.getElementById('btn-volver');

        btnVolver.addEventListener('click', () => window.location.href = "{{ path('app_descuento_index') }}");
        
    })
</script>
{% endblock %}