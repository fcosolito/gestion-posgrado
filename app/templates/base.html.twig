<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Welcome!{% endblock %}</title>
        <link rel="icon" href="{{ asset('images/logo_resized.png') }}">
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
        {% endblock %}
    </head>
    <body>
        <div class="container-fluid">
            <div class="row">
                <div class="col-auto p-0">
                    <div id="sidebar-root" data-page="{{ currentPage|default('/alumno') }}"></div>
                </div>
                <div class="col p-4" id="main-content">
                    <div class="main-content d-flex flex-column gap-2">
                        <div class="p-2 rounded color-titulo">
                            <h1>
                            {{ block("title") }}
                            </h1>
                        </div>
                        {% block body %}{% endblock %}
                    </div>
                </div>
            </div>
        </div>

        {{ encore_entry_script_tags('app') }}
        {{ encore_entry_link_tags('app') }}
    </body>
</html>
