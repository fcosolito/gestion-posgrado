<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Welcome!{% endblock %}</title>
        <link rel="icon" href="{{ asset('images/logo_resized.png') }}">
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
        {% endblock %}
        
        {{ encore_entry_link_tags('app') }}
    </head>
    <body>
        <div class="container-fluid">
            <div class="row">
                <div class="col-auto p-0">
                    <div id="sidebar-root" data-page="{{ currentPage|default('/alumno') }}"></div>
                </div>
                <div class="col p-4" id="main-content">
                    {% block body %}{% endblock %}
                </div>
            </div>
        </div>


        {{ encore_entry_script_tags('app') }}
    </body>
</html>
