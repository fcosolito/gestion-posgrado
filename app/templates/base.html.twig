<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Welcome!{% endblock %}</title>
        <link rel="icon" href="{{ asset('images/logo_resized.png') }}">
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
        {% endblock %}
    </head>
    <body>
        <div class="container-fluid">
            <div class="row">
                <div class="col-auto p-0 vh-100">
                    <div id="sidebar-root" data-page="{{ currentPage|default('/alumno') }}"></div>
                </div>
                <div class="col p-4 vh-100 overflow-scroll" id="main-content">
                    <div class="main-content ">
                        <div class="cabecera-azul">
                            <h1 class="titulo-principal">
                            {{ block("title") }}
                            </h1>
                        </div>
                        {% for message in app.flashes('notice') %}
                        <div class="p-2">
                            <div class="flash-notice">
                                <span>{{ message }}</span>
                                <button class="flash-close" onclick="this.parentElement.remove()">&times;</button>
                            </div>
                        </div>
                        {% endfor %}

                        {% for message in app.flashes('warning') %}
                        <div class="p-2">
                            <div class="alert alert-warning alert-dismissible fade show" role="alert">
                                {{ message|raw }}
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>
                        </div>
                        {% endfor %}

                        {% for message in app.flashes('error') %}
                        <div class="p-2">
                            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                {{ message|raw }}
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>
                        </div>
                        {% endfor %}

                        {% block body %}{% endblock %}
                    </div>
                </div>
            </div>
        </div>

        {{ encore_entry_script_tags('app') }}
        {{ encore_entry_link_tags('app') }}

    </body>
</html>
