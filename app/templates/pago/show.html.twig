{% extends 'base.html.twig' %}

{% block title %}Pago{% endblock %}

{% block body %}
    <h1>Pago</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ pago.id }}</td>
            </tr>
            <tr>
                <th>MontoPagado</th>
                <td>{{ pago.montoPagado }}</td>
            </tr>
            <tr>
                <th>MontoCuota</th>
                <td>{{ pago.montoCuota }}</td>
            </tr>
            <tr>
                <th>FechaPago</th>
                <td>{{ pago.fechaPago ? pago.fechaPago|date('Y-m-d') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_pago_index') }}">back to list</a>

    <a href="{{ path('app_pago_edit', {'id': pago.id}) }}">edit</a>

    {{ include('pago/_delete_form.html.twig') }}
{% endblock %}
