{% extends 'base.html.twig' %}

{% block title %}Pago{% endblock %}

{% block body %}
<div class="p-3">
    <div class="bg-white rounded mt-2">
        <table class="table">
            <tbody>
                <tr>
                    <th>Id</th>
                    <td>{{ pago.id }}</td>
                </tr>
                <tr>
                    <th>MontoPagado</th>
                    <td>{{ pago.monto}}</td>
                </tr>
                <tr>
                    <th>Fecha de Pago</th>
                    <td>{{ pago.fechaPago ? pago.fechaPago|date('Y-m-d') : '' }}</td>
                </tr>
                <tr>
                    <th>Comprobante</th>
                    <td>{{ pago.comprobante ? pago.comprobante : "<i>Adjuntar</i>"}}</td>
                </tr>
            </tbody>
        </table>

        <div class="row p-2">
            <div class="col-auto">
                <a class="btn btn-secondary" href="{{ path('app_pago_index') }}">Volver</a>
            </div>
            <div class="col-auto">
                <a class="btn btn-secondary" href="{{ path('app_pago_edit', {'id': pago.id}) }}">Editar</a>
            </div>
            <div class="col-auto">
                {{ include('pago/_delete_form.html.twig') }}
            </div>
        </div>
    </div>
</div>
{% endblock %}
