<div class="container-fluid">
    <div class="row">
        <div class="col-4">
            <div class="bg-white rounded p-2 mt-2">
                {{ form_start(form) }}
                <div class="row mt-2 mb-2">
                    <div class="col-4">
                        Monto
                    </div>
                    <div class="col-2">
                        {{ form_widget(form.monto) }}
                    </div>
                </div>
                <div class="row mt-2 mb-2">
                    <div class="col-4">
                        Fecha de Pago
                    </div>
                    <div class="col">
                        {{ form_widget(form.fechaPago) }}
                    </div>
                </div>
                <div class="row mt-2 mb-2">
                    <div class="col-4">
                        Comprobante
                    </div>
                    <div class="col">
                        {{ form_widget(form.comprobanteFile) }}
                        {% if pago.comprobante and pago.comprobante.archivo %}
                            <small class="text-muted d-block mt-2">
                                Archivo actual: {{ pago.comprobante.archivo }}
                                ({{ (pago.comprobante.tamano / 1024)|round(2) }} KB)
                            </small>
                        {% endif %}
                    </div>
                </div>
                <div class="row mt-2 mb-2">
                    <div class="col-4">
                    </div>
                    <div class="col">
                        <div class="row">
                            <div class="col">
                                <button class="btn btn-primary">{{ button_label|default('Save') }}</button>
                            </div>
                            <div class="col">

                            </div>
                        </div>
                    </div>
                </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
    
</div>

