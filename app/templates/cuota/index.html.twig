{% extends 'base.html.twig' %}

{% block title %}Cuota index{% endblock %}

{% block body %}
    <h1>Cuota index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>NumeroCuota</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for cuotum in cuotas %}
            <tr>
                <td>{{ cuotum.id }}</td>
                <td>{{ cuotum.numeroCuota }}</td>
                <td>
                    <a href="{{ path('app_cuota_show', {'id': cuotum.id}) }}">show</a>
                    <a href="{{ path('app_cuota_edit', {'id': cuotum.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="3">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_cuota_new') }}">Create new</a>
{% endblock %}
