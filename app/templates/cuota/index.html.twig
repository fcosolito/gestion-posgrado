{% extends 'base.html.twig' %}

{% block title %}Cuota{% endblock %}

{% block body %}

<div class="container">
    <div class="row mt-2">
        <div class="col-7 pe-1">
            <div class="rounded bg-white">
                {#<h3>{{ curso_carrera }}</h3>#}
                <h3>Curso/Carrera</h3>
            </div>
        </div>
        <div class="col">
            <div class="rounded bg-white">
                <h3>Cuota</h3>
            </div>
        </div>
    </div>

</div>
    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>NumeroCuota</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for cuotum in cuotas %}
            <tr>
                <td>{{ cuotum.id }}</td>
                <td>{{ cuotum.numeroCuota }}</td>
                <td>
                    <a href="{{ path('app_cuota_show', {'id': cuotum.id}) }}">show</a>
                    <a href="{{ path('app_cuota_edit', {'id': cuotum.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="3">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_cuota_new') }}">Create new</a>
{% endblock %}
