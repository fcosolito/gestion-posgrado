{% extends 'base.html.twig' %}

{% block title %}Cuota{% endblock %}

{% block body %}
<div id="cuota-index"
    data-cuotas="{{ cuotas|json_encode }}"
    data-carrera="{{ carrera|json_encode }}"
    data-curso="{{ curso|json_encode }}"
    data-edicion="{{ edicion|json_encode }}"
    data-alumno="{{ alumno|json_encode }}"
>
</div>
{% endblock %}

{% block javascripts %}

{{ encore_entry_script_tags('cuota_index') }}
{{ encore_entry_link_tags('cuota_index') }}

{% endblock %}
