{{ form_start(form) }}
<div class="row align-items-end">
    <div class="col-auto">
        <div class="me-2">
            <span class="fw-bold mb-2">Nombre</span>
            <br class="m-2">
            {{ form_widget(form.nombre, {'attr': {'class': 'form-control'}}) }}
        </div>
    </div>
    <div class="col-auto">
        <div class="me-2">
            <span class="fw-bold mb-2">Número de ordenanza</span>
            <br class="m-2">
            {{ form_widget(form.nroOrdenanza, {'attr': {'class': 'form-control'}}) }}
        </div>
    </div>
    <div class="col-auto">
        <div class="me-2">
            <span class="fw-bold mb-2">Número de implementación</span>
            <br class="m-2">
            {{ form_widget(form.nroImplementacion, {'attr': {'class': 'form-control'}}) }}
        </div>
    </div>
    <div class="col-auto">
        <div class="me-2">
            <span class="fw-bold mb-2">Horas</span>
            <br class="m-2">
            {{ form_widget(form.horas, {'attr': {'class': 'form-control'}}) }}
        </div>
    </div>
    <div class="col-auto">
        <div class="me-2">
            <button class="btn-verde">{{ button_label|default('Save') }}</button>
        </div>
    </div>
</div>
{{ form_end(form) }}