{% extends 'base.html.twig' %}

{% block title %}Cursos{% endblock %}

{% block body %}
<div class="p-3">
    <div class="p-3 mb-2 cuadrado-reutilizable">
        <div class="row align-items-center">
            <div class="col text-start">
                <h4>Buscar</h4>
            </div>
            
        </div>
        <div class="container ms-0">
        {{ form_start(form) }}
        <div class="row g-2">
            <div class="col">
                {{ form_label(form.nombre) }}
                {{ form_widget(form.nombre, {'attr': {'class': "form-control"}}) }}
            </div>
            <div class="col">
                {{ form_label(form.horas) }}
                {{ form_widget(form.horas, {'attr': {'class': "form-control"}}) }}
            </div>
            <div class="col">
                {{ form_label(form.ordenanza) }}
                {{ form_widget(form.ordenanza, {'attr': {'class': "form-control"}}) }}
            </div>
            <div class="col">
                {{ form_label(form.implementacion) }}
                {{ form_widget(form.implementacion, {'attr': {'class': "form-control"}}) }}
            </div>
            <div class="col align-items-end d-flex">
                {{ form_widget(form.buscar, {'attr': {'class': "btn-azul"}}) }}
            </div>
        </div>
        {{ form_end(form) }}
        </div>
    </div>
    <div class="cuadrado-reutilizable fill-remaining">
        <div class="row m-2">
            <div class="col">
                <h4>Cursos</h4>
            </div>
            <div class="col text-end">
                <button
                    id="btn-nuevo"
                    class="btn-verde"
                >
                    Nuevo
                </button>
            </div>
        </div>
        <table class="table table-bordered">
            <thead class="table-secondary sticky-top">
                <tr>
                    <th class="fw-normal">Nombre</th>
                    <th class="fw-normal">Horas</th>
                    <th class="fw-normal">Ordenanza</th>
                    <th class="fw-normal">Implementacion</th>
                    <th class="fw-normal">Acciones</th>
                </tr>
            </thead>
            <tbody>
            {% for curso in cursos %}
                <tr>
                    <td class="fw-light">{{ curso.nombre }}</td>
                    <td class="fw-light">{{ curso.horas }}</td>
                    <td class="fw-light">{{ curso.nroOrdenanza }}</td>
                    <td class="fw-light">{{ curso.nroImplementacion }}</td>
                    <td>
                        {{ include('_dropdown_acciones.html.twig', {
                                opciones: [
                                    { 
                                        label: 'Ver', 
                                        url: path('app_curso_show', {'id': curso.id}) 
                                    }
                                ]
                        }) }}
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="6">No se registraron cursos.</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>

{% endblock %}

{% block javascripts %}
<script>
    document.addEventListener('DOMContentLoaded', () => {

        const btnNuevo = document.getElementById('btn-nuevo');

        btnNuevo.addEventListener('click', () => window.location.href = "{{ path('app_curso_new') }}");
        
    })
</script>
{% endblock %}