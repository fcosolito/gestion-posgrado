{% extends 'base.html.twig' %}

{% block title %}Cursos{% endblock %}

{% block body %}

<div class="container-fluid p-3">
    <div class="row mb-3">
        <div class="col">
            <div id="curso"
                data-curso="{{ curso|json_encode }}"
                data-delete-form="{{ include('curso/_delete_form.html.twig')|e('html_attr') }}"
            >
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col">
            <div class="cuadrado-reutilizable fill-remaining">
                <div class="row p-3 mb-1">
                    <div class="col">
                        <h4>Ediciones</h4>
                    </div>
                    <div class="col text-end">
                        <button 
                            id="btn-nueva"
                            class="btn-azul"
                        >
                            Nueva
                        </button>
                    </div>
                </div>
                <div class="overflow-scroll" style="max-height: 50vh;">
                    <table class="table table-bordered">
                        <thead class="sticky-top table-secondary">
                            <tr>
                                <th class="fw-normal">Nombre</th>
                                <th class="fw-normal">Precio</th>
                                <th class="fw-normal">Acción</th>
                            </tr>
                        </thead>
                        <tbody>
                        {% for edicion in ediciones %}
                            <tr>
                                <td class="fw-light">{{ edicion.nombre }}</td>
                                <td class="fw-light">{{ edicion.precio }}</td>
                                <td>
                                    <div class="dropdown">
                                        <button class="btn btn-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                            Acciones
                                        </button>
                                        <ul class="dropdown-menu">
                                            <li>
                                                <a 
                                                    class="dropdown-item btn btn-secondary" 
                                                    href="{{ path('app_edicion_show', {'id': edicion.id }) }}"
                                                >
                                                    Ver
                                                </a>
                                            </li>
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <td><i colspan="3">No hay ediciones registradas</i></td>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col">
            <div id="carreras"
                data-carreras="{{ carreras|json_encode }}"
            >
            </div>
        </div>
    </div>
</div>

{# Eliminacion #}
{{ include('_modal_eliminacion.html.twig') }}
{% endblock %}

{% block javascripts %}
<script>
    document.addEventListener('DOMContentLoaded', () => {
        const form = document.getElementById("curso-delete-form");

        const btnNueva = document.getElementById('btn-nueva');

        btnNueva.addEventListener('click', () => window.location.href = "{{ path('app_edicion_new', {'cursoId': curso.id }) }}");
    })
</script>

{{ encore_entry_script_tags('curso_show') }}
{{ encore_entry_link_tags('curso_show') }}

{% endblock %}