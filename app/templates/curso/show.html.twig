{% extends 'base.html.twig' %}

{% block title %}Curso{% endblock %}

{% block body %}

    <div id="curso"
        data-curso="{{ curso|json_encode }}"
        data-delete-form="{{ include('curso/_delete_form.html.twig')|e('html_attr') }}"
    >
    </div>
    <div class="container-fluid">
        <div class="row">
            <div class="col-7 p-2 rounded bg-light">
                <div class="row m-1">
                    <div class="col-4">
                        <h3>Ediciones</h3>
                    </div>
                    <div class="col-1 ms-auto m-1">
                        <a class="btn btn-primary" href="{{ path('app_edicion_new', {'cursoId': curso.id }) }}">
                            Nueva
                        </a>
                    </div>
                </div>
                <div class="row m-1">
                    <div class="col bg-grey fw-bold">Nombre</div>
                    <div class="col bg-grey fw-bold">Inicio</div>
                    <div class="col bg-grey fw-bold">Fin</div>
                    <div class="col bg-grey fw-bold">Precio</div>
                    <div class="col bg-grey fw-bold">Acciones</div>
                </div>
                {% for edicion in ediciones %}
                <div class="row m-1">
                    <div class="col">{{ edicion.nombre }}</div>
                    <div class="col">{{ edicion.fechaInicio }}</div>
                    <div class="col">{{ edicion.fechaFin }}</div>
                    <div class="col">{{ edicion.precio }}</div>
                    <div class="col">
                        <div class="dropdown">
                            <button class="btn btn-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Acciones
                            </button>
                            <ul class="dropdown-menu">
                                <li>
                                    <a 
                                        class="dropdown-item btn btn-secondary" 
                                        href="{{ path('app_edicion_show', {'id': edicion.id }) }}"
                                    >
                                        Ver
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
                {% else %}
                <p class="m-1">No hay ediciones registradas</p>
                {% endfor %}

            </div>
            <div class="col-4 ms-auto p-2 rounded bg-light">
                <h3 class="m-1">Carreras</h3>
                <div class="row m-1">
                    <div class="col bg-grey fw-bold">Nombre</div>
                    <div class="col bg-grey fw-bold">Relacion</div>
                    <div class="col bg-grey fw-bold">Acciones</div>
                </div>
                {% for carrera in carreras %}
                <div class="row m-1">
                    <div class="col">{{ carrera.nombre }}</div>
                    <div class="col">
                    {% if carrera.electivo %}
                        Electivo
                    {% else %}
                        Obligatorio
                    {% endif %}
                    </div>
                    <div class="col">
                        <div class="dropdown">
                            <button class="btn btn-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Acciones
                            </button>
                            <ul class="dropdown-menu">
                                <li>Ver</li>
                            </ul>
                        </div>
                    </div>
                </div>
                {% else %}
                <p class="m-1">No hay carreras asociadas</p>
                {% endfor %}


            </div>
        </div>
    </div>

    {{ encore_entry_script_tags('curso_show') }}
    {{ encore_entry_link_tags('curso_show') }}
{% endblock %}
