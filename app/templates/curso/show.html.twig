{% extends 'base.html.twig' %}

{% block title %}Curso{% endblock %}

{% block body %}
    <div class="container-fluid p-3 rounded bg-white">
        <div class="row align-items-center">
            <div class="col text-start">
                <h2>{{ curso.nombre }}</h2>
            </div>
            <div class="col text-end">
                <a href="{{ path('app_curso_edit', { 'id': curso.id }) }}" class="btn btn-secondary">Editar</a>
            </div>
            <div class="col text-end">
                {{ include('curso/_delete_form.html.twig') }}
            </div>
                
        </div>
        <table class="table">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Horas</th>
                    <th>NroOrdenanza</th>
                    <th>NroImplementacion</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>{{ curso.nombre }}</td>
                    <td>{{ curso.horas }}</td>
                    <td>{{ curso.nroOrdenanza }}</td>
                    <td>{{ curso.nroImplementacion }}</td>
                </tr>
            </tbody>
        </table>
    </div>
    <div class="container-fluid p-3 rounded bg-white">
        <div class="row g-1 p-0 m-0">
            <div class="col-3 p-3 rounded bg-light">
                <div class="row">
                    <div class="col"><h1>Edicion</h1></div>
                    <div class="col">
                        {{ form_start(form) }}
                            {{ form_widget(form.edicion) }}
                        {{ form_end(form) }}
                        <a href="{{ path('app_edicion_new', {"cursoId": curso.id })}}" class="btn btn-primary">Nueva</a>
                    </div>
                </div>
                {% if edicion %}
                <table class="table">
                    <tbody>
                        <tr><th>Nombre</th><td>{{ edicion.nombre}}</td><td><a href="{{ path('app_edicion_edit', {"cursoId": curso.id, "id": edicion.id })}}" class="btn btn-primary">Editar</a></td></tr>
                        <tr><th>Precio</th><td>{{ edicion.precio}}</td></tr>
                    </tbody>
                </table>
                    <h3>Docentes</h3>
                    <ul>
                    {% for docente in docentes %}
                        <li>
                        {{ docente.nombre }}
                        {{ docente.apellido }}
                        {% if docente.esFirmante %}
                            Firmante: Si
                        {% else %}
                            Firmante: No
                        {% endif %}
                        </li>
                    {% endfor %}
                    </ul>
                {% endif %}
            </div>
            <div class="col-9 p-3 rounded bg-light">
                <h1>Alumnos</h1>
                <button>Inscribir</button>
            </div>
        </div>
    </div>

{% endblock %}
