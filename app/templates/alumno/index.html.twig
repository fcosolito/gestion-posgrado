

{% extends 'base.html.twig' %}

{% block title %}Alumnos{% endblock %}

{% block body %}

    <div class="contenedor-blanco">
        <div class="cuadrado-reutilizable auto-height">
            {# Header con título y botones #}
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 class="mb-0" id="form-title">Buscar</h4>
                <div class="d-flex gap-2">
                    {# Botones para modo búsqueda #}
                    <button class="btn-amarillo" type="submit" form="search-form" id="btn-buscar">Buscar</button>
                    <button class="btn-verde" id="btn-agregar" type="button">Agregar</button>
                    
                    {# Botones para modo registro (inicialmente ocultos) #}
                    <button class="btn-verde" type="submit" form="register-form" id="btn-guardar" style="display: none;">Guardar</button>
                    <button class="btn-rojo" id="btn-cancelar" type="button" style="display: none;">Cancelar</button>
                </div>
            </div>

            {# Formulario de Búsqueda #}
            <div id="buscar-container">
                {{ form_start(formBuscar, {'attr': {'id': 'search-form'}}) }}
                    <div class="row g-3">
                        <div class="col-md-3">
                            {{ form_label(formBuscar.nombre) }}
                            {{ form_widget(formBuscar.nombre, {'attr': {'class': 'form-control', 'placeholder': 'Ej: Nombre', 'maxlength': '255'}}) }}
                        </div>
                        <div class="col-md-3">
                            {{ form_label(formBuscar.apellido) }}
                            {{ form_widget(formBuscar.apellido, {'attr': {'class': 'form-control', 'placeholder': 'Ej: Apellido', 'maxlength': '255'}}) }}
                        </div>
                        <div class="col-md-3">
                            {{ form_label(formBuscar.dni) }}
                            {{ form_widget(formBuscar.dni, {'attr': {'class': 'form-control', 'placeholder': 'Ej: 99999999', 'maxlength': '11'}}) }}
                        </div>
                        <div class="col-md-3">
                            {{ form_label(formBuscar.email) }}
                            {{ form_widget(formBuscar.email, {'attr': {'class': 'form-control', 'placeholder': 'Ej: mail@ejemplo.com', 'maxlength': '255'}}) }}
                        </div>
                    </div>
                {{ form_end(formBuscar) }}
            </div>
            {# Formulario de Registro (inicialmente oculto) #}
            <div id="crear-container" style="display: none;">
                {{ form_start(formCrear, {'attr': {'id': 'register-form'}}) }}
                    <div class="row g-3">
                        <div class="col-md-3">
                            {{ form_label(formCrear.nombre) }}
                            {{ form_widget(formCrear.nombre, {'attr': {'class': 'form-control', 'placeholder': 'Ej: Nombre', 'maxlength': '255'}}) }}
                        </div>
                        <div class="col-md-3">
                            {{ form_label(formCrear.apellido) }}
                            {{ form_widget(formCrear.apellido, {'attr': {'class': 'form-control', 'placeholder': 'Ej: Apellido', 'maxlength': '255'}}) }}
                        </div>
                        <div class="col-md-3">
                            {{ form_label(formCrear.dni) }}
                            {{ form_widget(formCrear.dni, {'attr': {'class': 'form-control', 'placeholder': 'Ej: 99999999', 'maxlength': '11'}}) }}
                        </div>
                        <div class="col-md-3">
                            {{ form_label(formCrear.email) }}
                            {{ form_widget(formCrear.email, {'attr': {'class': 'form-control', 'placeholder': 'Ej: mail@ejemplo.com', 'maxlength': '255'}}) }}
                        </div>
                    </div>
                    <div class="row g-3 pt-1">
                        <div class="col-md-3">
                            {{ form_label(formCrear.telefono) }}
                            {{ form_widget(formCrear.telefono, {'attr': {'class': 'form-control', 'placeholder': 'Ej: 3424223464', 'maxlength': '255'}}) }}
                        </div>
                        <div class="col-md-3">
                            {{ form_label(formCrear.tituloGrado) }}
                            {{ form_widget(formCrear.tituloGrado, {'attr': {'class': 'form-control', 'placeholder': 'Ej: Ingeniero en Sistemas', 'maxlength': '255'}}) }}
                        </div>
                        <div class="col-md-3">
                            {{ form_label(formCrear.fechaNacimiento) }}
                            {{ form_widget(formCrear.fechaNacimiento, {'attr': {'class': 'form-control', }}) }}
                        </div>
                    </div>
                {{ form_end(formCrear) }}
            </div>
        </div>
        
        <div class="cuadrado-reutilizable fill-remaining" style="padding-top: 1.5rem">
            <div id="lista-alumnos"
                 data-labels='["Nombre","Apellido","DNI","Correo","Acciones"]'
                 data-attributes='["nombre","apellido","dni","email"]'
                 data-rows='{{ alumnos|json_encode(constant('JSON_UNESCAPED_UNICODE'))|e('html_attr') }}'
                 data-csrf-token-prefix="delete">
            </div>
        </div>
    </div>

    {# Formularios ocultos para eliminar (uno por cada alumno) #}
    {% for alumno in alumnos %}
        <div id="delete-form-{{ alumno.id }}" style="display: none;">
            {{ include('alumno/_delete_form.html.twig') }}
        </div>
    {% endfor %}

    <!-- Modal de Confirmación de Eliminación -->
    {{ include('alumno/_modal_eliminacion.html.twig') }}

{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        // Toggle entre modo búsqueda y registro
        document.addEventListener('DOMContentLoaded', () => {

            const btnAgregar = document.getElementById('btn-agregar');
            const btnCancelar = document.getElementById('btn-cancelar');
            const btnBuscar = document.getElementById('btn-buscar');
            const btnGuardar = document.getElementById('btn-guardar');
            
            const buscarContainer = document.getElementById('buscar-container');
            const crearContainer = document.getElementById('crear-container');
            const formTitle = document.getElementById('form-title');

            // Cambiar a modo registro
            btnAgregar.addEventListener('click', () => {
                buscarContainer.style.display = 'none';
                btnBuscar.style.display = 'none';
                btnAgregar.style.display = 'none';
                
                crearContainer.style.display = 'block';
                btnGuardar.style.display = 'inline-block';
                btnCancelar.style.display = 'inline-block';
                
                formTitle.textContent = 'Registrar Alumno';
            });

            // Cambiar a modo búsqueda
            btnCancelar.addEventListener('click', () => {
                crearContainer.style.display = 'none';
                btnGuardar.style.display = 'none';
                btnCancelar.style.display = 'none';
                
                buscarContainer.style.display = 'block';
                btnBuscar.style.display = 'inline-block';
                btnAgregar.style.display = 'inline-block';
                
                formTitle.textContent = 'Buscar';
            });
        });
    </script>
    {{ encore_entry_script_tags('alumno') }}
    {{ encore_entry_link_tags('alumno') }}

{% endblock %}

