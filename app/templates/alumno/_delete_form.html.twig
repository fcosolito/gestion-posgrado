<button class="btn-peligro" 
        type="button" 
        data-bs-toggle="modal" 
        data-bs-target="#deleteModal"
        data-alumno-id="{{ alumno.id }}"
        data-alumno-nombre="{{ alumno.nombre }} {{ alumno.apellido }}">
    Eliminar
</button>

<form method="post" action="{{ path('app_alumno_delete', {'id': alumno.id}) }}" id="form-eliminar-alumno-{{ alumno.id }}" style="display: none;">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ alumno.id) }}">
</form>
