<button class="btn-peligro" 
        type="button" 
        onclick="mostrarModalEliminar(
            'Confirmar eliminación',
            '¿Está seguro de que desea eliminar este alumno?',
            '{{ alumno.nombre }} {{ alumno.apellido }}',
            () => document.getElementById('form-eliminar-alumno-{{ alumno.id }}').submit()
        )">
    Eliminar
</button>

<form method="post" action="{{ path('app_alumno_delete', {'id': alumno.id}) }}" id="form-eliminar-alumno-{{ alumno.id }}" style="display: none;">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ alumno.id) }}">
    <button class="btn btn-danger">Delete</button>
</form>
