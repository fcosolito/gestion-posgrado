<!-- Modal Inscripción a Carrera -->
<div class="modal fade" id="inscribirModal" tabindex="-1" aria-labelledby="modalInscripcionCarreraLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
        <div class="modal-header">
            <h1 class="modal-title fs-5" id="modalInscripcionCarreraLabel">
                Inscribir <span id="alumno-nombre-modal"></span> en <span id="carrera-nombre-modal"></span>
            </h1>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
            <form id="form-inscripcion-carrera">
                <input type="hidden" id="inscripcion-id-hidden" name="carrera_id">
                <input type="hidden" id="alumno-id-hidden" name="alumno_id">
                
                <div class="mb-3">
                    <label for="nro-legajo-input" class="form-label" style="color: #000000; font-weight: 500;">Número de Legajo <small class="text-muted">(Opcional)</small></label>
                    <input type="number" 
                           class="form-control" 
                           id="nro-legajo-input" 
                           name="nro_legajo" 
                           min="0"
                           placeholder="Ej: 12345">
                </div>
                
                <div class="mb-3">
                    <label for="descuento-select" class="form-label" style="color: #000000; font-weight: 500;">Descuento</label>
                    <select class="form-select" 
                            id="descuento-select" 
                            name="descuento_id">
                        <option value="">Sin descuento</option>
                        {% for descuento in descuentos %}
                            <option value="{{ descuento.id }}" 
                                    data-valor="{{ descuento.valor }}"
                                    data-descripcion="{{ descuento.descripcion }}">
                                {{ descuento.descripcion }} - {{ descuento.valor }}%
                            </option>
                        {% endfor %}
                    </select>
                </div>

                <!-- Campos ocultos para el descuento -->
                <input type="hidden" id="descuento-valor-hidden" name="valorDescuento" value="0">
                <input type="hidden" id="descripcion-descuento-hidden" name="descripcionDescuento" value="">

                <!-- Mostrar información del descuento seleccionado -->
                <div class="alert alert-info mt-2" id="info-descuento" style="display: none;">
                    <small>
                        <strong>Descuento aplicado:</strong>
                        <span id="valor-texto"></span>% - 
                        <span id="descripcion-texto"></span>
                    </small>
                </div>

                <a href="/descuento" class="text-decoration-none text-primary" style="font-size: 0.9em; margin-bottom: 15px; display: block;">Crear descuento</a>
                
                <div class="mb-3">
                    <label for="fecha-inscripcion-input" class="form-label" style="color: #000000; font-weight: 500;">Fecha de Inscripción</label>
                    <input type="date" 
                           class="form-control" 
                           id="fecha-inscripcion-input" 
                           name="fecha_inscripcion"
                           required>
                </div>
            </form>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn-gris" data-bs-dismiss="modal">Cancelar</button>
            <button type="button" class="btn-verde" id="btn-confirmar-inscripcion">
                Confirmar inscripción
            </button>
        </div>
        </div>
    </div>
</div>
