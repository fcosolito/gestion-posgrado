{{ form_start(form) }}
<div class="row align-items-end">
    <div class="col-auto">
        <div class="me-2">
            <span class="fw-bold mb-2">Nombre</span>
            <br class="m-2">
            {{ form_widget(form.nombre, {'attr': {'class': 'form-control'}}) }}
        </div>
    </div>
    <div class="col-auto">
        <div class="me-2">
            <span class="fw-bold mb-2">Fecha de inicio</span>
            <br class="m-2">
            {{ form_widget(form.fechaInicio, {'attr': {'class': 'form-control'}}) }}
        </div>
    </div>
    <div class="col-auto">
        <div class="me-2">
            <span class="fw-bold mb-2">Fecha de fin</span>
            <br class="m-2">
            {{ form_widget(form.fechaFin, {'attr': {'class': 'form-control'}}) }}
        </div>
    </div>
    <div class="col-auto">
        <div class="me-2">
            <span class="fw-bold mb-2">Precio</span>
            <br class="m-2">
            {{ form_widget(form.precio, {'attr': {'class': 'form-control'}}) }}
        </div>
    </div>
    <div class="col-auto">
        <div class="me-2">
            <button class="btn-verde">{{ button_label|default('Save') }}</button>
        </div>
    </div>
</div>
{{ form_end(form) }}
